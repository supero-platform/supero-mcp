#!/usr/bin/env python3
"""Write docs/tool-groups.json from the server's own list of tool groups.

The source of truth is CORE and GROUPS in the Supero platform repo,
platform/ai-service/src/services/mcp_features.py. This repo keeps a JSON copy so CI
and scripts/gen-guidance can check tool names without the platform source.

    SUPERO_SRC=~/supero python3 scripts/gen-tool-groups          rewrite the copy
    SUPERO_SRC=~/supero python3 scripts/gen-tool-groups --check  exit 1 if it differs
"""
import json
import os
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "docs" / "tool-groups.json"
src = pathlib.Path(os.path.expanduser(os.environ.get("SUPERO_SRC", "~/supero")))
sys.path.insert(0, str(src / "platform" / "ai-service" / "src" / "services"))
import mcp_features as mf  # noqa: E402

data = {
    "_comment": "Generated by scripts/gen-tool-groups from the Supero server's "
                "mcp_features.py (CORE and GROUPS). Do not edit.",
    "url": "https://mcp.supero.dev/mcp",
    "core": list(mf.CORE),
    "groups": {g: list(names) for g, names in mf.GROUPS.items()},
}
text = json.dumps(data, indent=2) + "\n"
if "--check" in sys.argv:
    if not OUT.exists() or OUT.read_text() != text:
        print(f"{OUT.relative_to(ROOT)} differs from mcp_features.py; run scripts/gen-tool-groups")
        sys.exit(1)
    print("tool-groups.json up to date")
    sys.exit(0)
OUT.write_text(text)
print(f"wrote {OUT.relative_to(ROOT)}: core {len(mf.CORE)}, groups {', '.join(mf.GROUPS)}")

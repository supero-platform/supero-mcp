#!/usr/bin/env python3
"""Generate every client's build guidance from guidance/build.md.

    python3 scripts/gen-guidance           rewrite the generated files
    python3 scripts/gen-guidance --check   exit 1 if any generated file differs

guidance/build.md is the only file to edit. This script writes:

    plugins/supero/skills/supero-build/SKILL.md               Claude Code (and Cursor) skill
    plugins/supero/rules/supero.mdc                           Cursor rule
    plugins/supero-antigravity/skills/supero-build/SKILL.md   Antigravity skill
    plugins/supero-antigravity/rules/AGENTS.md                Antigravity always-on rule (short)
    GEMINI.md                                                 Gemini CLI extension context
    AGENTS.md                                                 Codex and other AGENTS.md readers
    llms.txt, llms-full.txt                                   for assistants that read llms.txt

It also renders the tool list in README.md between the tools:start and tools:end
markers, from docs/tool-groups.json. Standard library only.
"""
import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SOURCE = ROOT / "guidance" / "build.md"
GROUPS = ROOT / "docs" / "tool-groups.json"
README = ROOT / "README.md"
NOTE = "Generated from guidance/build.md by scripts/gen-guidance. Do not edit this file; edit guidance/build.md and run the script."
COMMENT = f"<!-- {NOTE} -->"
SKILL_NAME = "supero-build"
SKILL_DESCRIPTION = ("Use when building or changing an app's backend with Supero: "
                     "schemas, tenants, roles, services, deploy.")
CURSOR_DESCRIPTION = ("Building or changing an app's backend on Supero through the supero MCP "
                      "server: build sequence, tool groups, pitfalls.")
REPO = "https://github.com/supero-platform/supero-mcp"
RAW = "https://raw.githubusercontent.com/supero-platform/supero-mcp/main"
TOOLS_START = "<!-- tools:start (generated by scripts/gen-guidance from docs/tool-groups.json) -->"
TOOLS_END = "<!-- tools:end -->"

GROUP_BLURB = {
    "ops": "logs, preflight checks, reports, deletes and teardown",
    "schemas": "change or delete schemas saved in a project",
    "services": "platform services, integrations and example apps",
    "sdk": "generate and download client SDKs",
    "testing": "smoke and end-to-end tests of a deployed app",
    "connectors": "outside data sources and connector runs",
    "rbac": "check permissions and key scope",
    "production": "permanent URL, live mode and project changes",
}


def sections(text):
    """{h2 heading: section text including the heading}."""
    out, cur, buf = {}, None, []
    for line in text.splitlines(keepends=True):
        if line.startswith("## "):
            if cur:
                out[cur] = "".join(buf)
            cur, buf = line[3:].strip(), [line]
        elif cur:
            buf.append(line)
    if cur:
        out[cur] = "".join(buf)
    return out


def frontmatter(fields):
    lines = ["---"]
    for k, v in fields:
        if isinstance(v, bool):
            lines.append(f"{k}: {'true' if v else 'false'}")
        else:
            lines.append(f"{k}: {json.dumps(v)}" if ":" in v or v.startswith(("'", '"')) else f"{k}: {v}")
    lines.append("---")
    return "\n".join(lines) + "\n"


def outputs(src):
    body = src if src.endswith("\n") else src + "\n"
    sec = sections(body)
    title = body.splitlines()[0].lstrip("# ").strip()
    intro = body.split("\n## ", 1)[0].split("\n", 1)[1].strip()
    skill = frontmatter([("name", SKILL_NAME), ("description", SKILL_DESCRIPTION)]) + "\n" + COMMENT + "\n\n" + body
    mdc = frontmatter([("description", CURSOR_DESCRIPTION), ("alwaysApply", False)]) + "\n" + COMMENT + "\n\n" + body
    plain = COMMENT + "\n\n" + body
    short_rule = (COMMENT + "\n\n# Supero\n\n" + intro + "\n\n" + sec["How the server is reached"]
                  + "\nThe build sequence, tool groups, pitfalls and starter prompts are in the "
                  "`supero-build` skill of this plugin.\n")
    llms = (f"# Supero MCP\n\n> {intro.splitlines()[0]}\n\n"
            "The server is at https://mcp.supero.dev/mcp (Streamable HTTP, OAuth sign-in). "
            "New connections use https://mcp.supero.dev/mcp?features=core.\n\n"
            "## Docs\n\n"
            f"- [Build guidance]({RAW}/guidance/build.md): build sequence, tool groups, pitfalls and starter prompts\n"
            f"- [Full guidance in one file]({RAW}/llms-full.txt)\n"
            f"- [Tool groups as JSON]({RAW}/docs/tool-groups.json)\n"
            f"- [Tool reference]({REPO}/blob/main/docs/tools.md)\n"
            f"- [Connect an editor or CLI]({REPO}/blob/main/docs/connect-editors.md)\n"
            f"- [Connect ChatGPT or Claude]({REPO}/blob/main/docs/connect-chatgpt-claude.md)\n\n"
            "## Optional\n\n"
            f"- [Project briefs]({REPO}/blob/main/projects/README.md): apps worth building, written as requirements\n"
            "- [Reference apps](https://github.com/supero-platform/supero-apps): complete apps with source\n"
            "- [Documentation](https://docs.supero.dev/developers/mcp/overview/)\n\n"
            + COMMENT + "\n")
    llms_full = body + "\n" + COMMENT + "\n"
    assert title
    return {
        "plugins/supero/skills/supero-build/SKILL.md": skill,
        "plugins/supero/rules/supero.mdc": mdc,
        "plugins/supero-antigravity/skills/supero-build/SKILL.md": skill,
        "plugins/supero-antigravity/rules/AGENTS.md": short_rule,
        "GEMINI.md": plain,
        "AGENTS.md": plain,
        "llms.txt": llms,
        "llms-full.txt": llms_full,
    }


def tools_section(groups):
    core = groups["core"]
    lines = [TOOLS_START, "",
             f"A connection to `https://mcp.supero.dev/mcp?features=core` has the {len(core)} core tools:", "",
             ", ".join(f"`{t}`" for t in core) + ".", "",
             "Other tools come in groups. Add a group to the URL to get its tools, for example "
             "`https://mcp.supero.dev/mcp?features=core,services`, or use `features=all` for every tool. "
             "Without `features` the server offers every tool, as it always has.", "",
             "| Group | What it adds | Tools |", "|---|---|---|"]
    for g, names in groups["groups"].items():
        lines.append(f"| `{g}` | {GROUP_BLURB.get(g, '')} | " + ", ".join(f"`{n}`" for n in names) + " |")
    lines += ["", "Add `read_only=true` to keep only tools that change nothing. Every tool, with its "
              "arguments, is in [docs/tools.md](docs/tools.md).", "", TOOLS_END]
    return "\n".join(lines)


def render_readme(text, groups):
    pat = re.compile(re.escape(TOOLS_START) + r".*?" + re.escape(TOOLS_END), re.S)
    if not pat.search(text):
        raise SystemExit("README.md has no tools:start/tools:end markers")
    return pat.sub(lambda _m: tools_section(groups), text)


def main():
    check = "--check" in sys.argv
    files = outputs(SOURCE.read_text())
    groups = json.loads(GROUPS.read_text())
    files["README.md"] = render_readme(README.read_text(), groups)
    drift = []
    for rel, text in files.items():
        p = ROOT / rel
        if check:
            if not p.exists() or p.read_text() != text:
                drift.append(rel)
        else:
            p.parent.mkdir(parents=True, exist_ok=True)
            if not p.exists() or p.read_text() != text:
                p.write_text(text)
                print(f"wrote {rel}")
    if check:
        if drift:
            print("out of date (run python3 scripts/gen-guidance):\n  " + "\n  ".join(drift))
            sys.exit(1)
        print(f"guidance: {len(files)} generated files up to date")


if __name__ == "__main__":
    main()
